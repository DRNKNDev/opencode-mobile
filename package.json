{
  "name": "patjoe",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "bun run --filter @patjoe/mobile start",
    "mobile:android": "bun run --filter @patjoe/mobile android",
    "mobile:ios": "bun run --filter @patjoe/mobile ios",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DRNKNDev/opencode-mobile.git"
  },
  "keywords": [],
  "author": "DRNKNDev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DRNKNDev/opencode-mobile/issues"
  },
  "homepage": "https://github.com/DRNKNDev/opencode-mobile#readme",
  "description": "Opencode mobile client",
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "~5.8.3"
  }
}
